{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outthink/events",
	"version": "1.4.0",
	"title": "Upcoming Events",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "A list of upcoming events that drops past events automatically, even on cached pages.",
	"keywords": [ "events", "calendar", "schedule" ],
	"textdomain": "outthink-events",
	"attributes": {
		"limit": {
			"type": "integer",
			"default": 0
		},
		"category": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "ot-events"
}
